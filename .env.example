# Optional OpenAI-compatible endpoint. Leave unset for deterministic, no-key mode.
# Use only a provider/model whose current terms you have confirmed are free for your use.
LLM_API_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional overrides
NEWS_MAX_AGE_HOURS=36
NEWS_HISTORY_DAYS=2
NEWS_MAX_FEED_ITEMS=40
# Minimum approximate Google Trends RSS traffic lower-bound for a story to be considered high-trending.
NEWS_MIN_TREND_SEARCHES=10000
NEWS_TREND_QUERIES_PER_GEO=20
NEWS_TREND_ARTICLES_PER_QUERY=20
# When public Trends topics miss the audience, check up to six leading current
# MBA headlines per region in Google News RSS for independent publisher pickup.
NEWS_COVERAGE_QUERIES_PER_REGION=12
# GitHub Actions sets this true for scheduled runs and manual retries.
NEWS_ALLOW_REPEAT_BATCH=false
